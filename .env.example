# Referencia: Spring Boot no lee este archivo. Cópielo a .env (ignorado por Git) y complete los secretos:
# Docker Compose lo lee solo; para ./mvnw spring-boot:run exporte las variables en su terminal.
# Nunca ponga valores reales aquí.

# --- JWT de IAM (obligatoria, sin valor por defecto) ---
# La MISMA clave que usa IAM como JWT_SECRET_BASE64: Base64 estándar, se decodifica a bytes (mínimo 32).
# Genere una con:  openssl rand -base64 32
JWT_SECRET_BASE64=
# iss exacto y aud que debe incluir este valor. Coinciden con los valores por defecto de IAM.
JWT_ISSUER=foodly-iam
JWT_AUDIENCE=foodly-radar
# Nombres de los claims (opcional)
# JWT_USER_ID_CLAIM=sub
# JWT_ROLE_CLAIM=role

# --- Eventos de Business v1 ---
# Exchange topic durable donde publica Business (routing keys business.<Tipo>).
BUSINESS_EVENTS_EXCHANGE=foodly.business

# --- Infraestructura (perfil local; el compose ya define las suyas) ---
REDIS_URL=redis://localhost:6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Servidor ---
# Mapa de puertos del proyecto: Kong 8000, Business 8080, IAM 8081, Radar 8082, Messaging 8083, Reservation 8084.
# Radar escucha en 8082 por defecto; el gateway (foodly-infra) le reenvía /radar a ese puerto.
SERVER_PORT=8082
RADAR_HOST_PORT=8082
